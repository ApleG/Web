            "size": 4076,
            "mimeType": "application/json",
            "text": "{\"success\":true,\"code\":\"200\",\"msg\":\"操作成功\",\"data\":{\"downgrade.holiday.studynote.wind\":{\"level\":0,\"downGradeTips\":\"学习笔记风云榜暂不可用，请稍晚再重试，为您带来的不便深表歉意\"},\"teacher_homework_class_detail\":{\"level\":0,\"downGradeTips\":\"当前教师访问人数过多，暂不可查看\"},\"downgrade.studygroup.bigdata.class.detail\":{\"level\":0,\"downGradeTips\":\"使用量暴增，服务器压力较大，请稍晚再试\"},\"homework_record_page\":{\"level\":0,\"downGradeTips\":\"老师作业列表页降级总人数参与人数\"},\"downgrade.student.sbr.video.serious.check\":{\"level\":0,\"downGradeTips\":\"假期访问人数多，校本视频认真度检查功能暂不可用\"},\"downgrade.holiday.studynote.fillingdegree\":{\"level\":0,\"downGradeTips\":\"当前为使用高峰期，笔记填充度计算可能会有较长的延迟，望见谅\"},\"downgrade.eteacher.teacher.homepage.overview\":{\"level\":0,\"downGradeTips\":\"当天数据将于第二天更新\"},\"downgrade.holiday.studynote.mynote\":{\"level\":0,\"downGradeTips\":\"当前为使用高峰期，【笔记风云榜】、【笔记光荣榜】可能会出现数据加载延迟的情况，请见谅。\"},\"downgrade.sbr.resource\":{\"level\":0,\"downGradeTips\":\"当前校本资源Word上传开关关闭\"},\"downgrade.studygroup.bigdata.grade.rank.tasks\":{\"level\":0,\"downGradeTips\":\"使用量暴增，服务器压力较大，请稍晚再试\"},\"downgrade.app.homework.progress\":{\"level\":0,\"downGradeTips\":\"访问人数过多，数据可能会有延迟！\"},\"downgrade_studynote_when_bigdata_unavailable\":{\"level\":0,\"downGradeTips\":\"当前使用高峰期部分数据与功能暂不可用，紧急修复中\"},\"homework_detail_page\":{\"level\":0,\"downGradeTips\":\"当前使用高峰期，作业完成数据将延迟5-10分钟更新\"},\"downgrade.holiday.student.big.stat\":{\"level\":0,\"downGradeTips\":\"访问人数过多，学生学习对比度数据暂不可用\"},\"downgrade_gradethree_when_bigdata_unavailable\":{\"level\":0,\"downGradeTips\":\"当前使用高峰期部分数据与功能暂不可用，紧急修复中\"},\"downgrade_common_when_es_delay\":{\"level\":0,\"downGradeTips\":\"当前使用高峰期，部分数据将延迟5-10分钟更新\"},\"new.gradethree.statistics\":{\"level\":0,\"downGradeTips\":\"在线学习人数过多，暂停数据统计\"},\"student_homework_list_page\":{\"level\":0,\"downGradeTips\":\"叮~前方同学扎堆学习中，看课状态将在3小时后更新~\"},\"downgrade.holiday.studynote.glory\":{\"level\":0,\"downGradeTips\":\"学习笔记光荣榜暂不可用，请稍晚再重试，为您带来的不便深表歉意\"},\"publish_homework_page\":{\"level\":0,\"downGradeTips\":\"当前教师使用量暴增，作业布置后发送到学生手上时间会有60分钟左右延迟，请合理规划好布置时间。\"},\"downgrade.student.video.serious.check\":{\"level\":0,\"downGradeTips\":\"当前为使用高峰期，课程视频监测功能暂不可用\"},\"sbr_video_uploading_page\":{\"level\":0,\"downGradeTips\":\"当前校本视频使用量暴增，上传转码服务延迟8-12小时，敬请谅解\"},\"downgrade.stu.task.detetail.excitation\":{\"level\":0,\"downGradeTips\":\"访问人数多，功能暂不可用\"},\"downgrade_common_when_es_unavailable\":{\"level\":0,\"downGradeTips\":\"当前使用高峰期部分数据与功能暂不可用，紧急修复中\"},\"teacher_homework_detail\":{\"level\":0,\"downGradeTips\":\"当前教师访问人数过多，暂不可查看\"},\"student_homework_detail_page\":{\"level\":0,\"downGradeTips\":\"叮~前方用户扎堆，任务进度数据预计3小时后更新~\"},\"downgrade.holiday.student.data.stat\":{\"level\":0,\"downGradeTips\":\"学习状态与作业进度服务暂不可用，请稍晚再试，为您带来的不便深表歉意\"},\"downgrade_gradethree_configdata_query\":{\"level\":0,\"downGradeTips\":\"当前使用高峰期部分数据与功能暂不可用，紧急修复中\"},\"downgrade.holiday.student.homepage.notice\":{\"level\":0,\"downGradeTips\":\"叮~前方用户扎堆，任务进度数据1小时后更新~\"},\"downgrade.eteacher.medal.tasks\":{\"level\":0,\"downGradeTips\":\"学委课代表视频进度降级\"}}}"
