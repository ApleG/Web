            "mimeType": "text/css",
            "text": ".ewt-homework-rich-text {\n  font-size: 14px;\n  font-weight: 400;\n  color: #333333;\n  line-height: 1.8;\n  word-wrap: break-word;\n  overflow: auto;\n}\n.ewt-homework-rich-text img {\n  max-width: 100%;\n  height: auto;\n  vertical-align: middle;\n}\n.ewt-homework-rich-text h1, .ewt-homework-rich-text h2, .ewt-homework-rich-text h3, .ewt-homework-rich-text h4, .ewt-homework-rich-text h5, .ewt-homework-rich-text h6 {\n  display: block;\n  margin-inline-start: 0px;\n  margin-inline-end: 0px;\n  font-weight: bold;\n}\n.ewt-homework-rich-text h1 {\n  font-size: 2em;\n  margin-block-start: 0.67em;\n  margin-block-end: 0.67em;\n}\n.ewt-homework-rich-text h2 {\n  font-size: 1.5em;\n  margin-block-start: 0.83em;\n  margin-block-end: 0.83em;\n}\n.ewt-homework-rich-text h3 {\n  font-size: 1.17em;\n  margin-block-start: 1em;\n  margin-block-end: 1em;\n}\n.ewt-homework-rich-text h4 {\n  margin-block-start: 1.33em;\n  margin-block-end: 1.33em;\n}\n.ewt-homework-rich-text h5 {\n  font-size: 0.83em;\n  margin-block-start: 1.67em;\n  margin-block-end: 1.67em;\n}\n.ewt-homework-rich-text h6 {\n  font-size: 0.67em;\n  margin-block-start: 2.33em;\n  margin-block-end: 2.33em;\n}\n.ewt-homework-rich-text strong {\n  font-weight: bold;\n}\n.ewt-homework-rich-text em {\n  font-style: italic;\n}\n.ewt-homework-rich-text p {\n  display: block;\n  margin: 0;\n}\n.ewt-homework-rich-text sup {\n  vertical-align: super;\n  font-size: smaller;\n}\n.ewt-homework-rich-text sub {\n  vertical-align: sub;\n  font-size: smaller;\n}\n.ewt-homework-rich-text pre {\n  display: block;\n  font-family: monospace;\n  white-space: pre;\n  margin: 1em 0px;\n}\n.ewt-homework-rich-text ul, .ewt-homework-rich-text ol {\n  display: block;\n  margin-block-start: 1em;\n  margin-block-end: 1em;\n  margin-inline-start: 0px;\n  margin-inline-end: 0px;\n  padding-inline-start: 40px;\n}\n.ewt-homework-rich-text ul {\n  list-style-type: disc;\n}\n.ewt-homework-rich-text ol {\n  list-style-type: decimal;\n}\n.ewt-homework-rich-text li {\n  display: list-item;\n  text-align: -webkit-match-parent;\n}\n.ewt-homework-rich-text table {\n  max-width: 100%;\n}\n.ewt-homework-rich-text table td {\n  border: 1px solid;\n  padding: 0 5px;\n  text-align: justify;\n}\n\n/*# sourceMappingURL=rich-text.css.map */\n"
